{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Owner-isolated user preferences and configuration for bullion display and notifications.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID owning this profile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name shown in account menu.",
          "minLength": 1,
          "maxLength": 80
        },
        "preferredCurrency": {
          "type": "string",
          "description": "Default currency for ticker and charts.",
          "enum": ["INR", "USD"]
        },
        "preferredUnit": {
          "type": "string",
          "description": "Default bullion weight unit.",
          "enum": ["10g", "1g", "oz", "kg"]
        },
        "indiaCity": {
          "type": "string",
          "description": "Selected Indian bullion hub for indicative regional rates.",
          "enum": ["Mumbai", "Delhi", "Chennai", "Bengaluru", "Kolkata", "Hyderabad"]
        },
        "includeIndiaTaxes": {
          "type": "boolean",
          "description": "Whether to include India customs duty and 3% GST in INR landed rates."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether push alert notifications are opted in."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest preference update."
        }
      },
      "required": [
        "userId",
        "displayName",
        "preferredCurrency",
        "preferredUnit",
        "indiaCity",
        "includeIndiaTaxes",
        "notificationsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortfolioHolding": {
      "title": "PortfolioHolding",
      "description": "An individual Gold or Silver investment lot tracked in the user's portfolio.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "metal": {
          "type": "string",
          "description": "Precious metal type.",
          "enum": ["GOLD", "SILVER"]
        },
        "purity": {
          "type": "string",
          "description": "Karat or fineness grade.",
          "enum": ["24K", "22K", "18K", "999"]
        },
        "quantity": {
          "type": "number",
          "description": "Amount held in the specified weight unit."
        },
        "unit": {
          "type": "string",
          "description": "Weight unit of the holding quantity.",
          "enum": ["g", "10g", "oz", "kg"]
        },
        "buyPrice": {
          "type": "number",
          "description": "Purchase price per single selected unit."
        },
        "currency": {
          "type": "string",
          "description": "Purchase currency.",
          "enum": ["INR", "USD"]
        },
        "purchaseDate": {
          "type": "string",
          "description": "Purchase date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "label": {
          "type": "string",
          "description": "User note or instrument label (e.g., SGB, 24K Coin).",
          "minLength": 0,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest edit."
        }
      },
      "required": [
        "userId",
        "metal",
        "purity",
        "quantity",
        "unit",
        "buyPrice",
        "currency",
        "purchaseDate",
        "label",
        "createdAt",
        "updatedAt"
      ]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "A threshold alert rule that triggers a push notification when live Gold or Silver crosses targetPrice.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "metal": {
          "type": "string",
          "description": "Target metal.",
          "enum": ["GOLD", "SILVER"]
        },
        "condition": {
          "type": "string",
          "description": "Trigger direction.",
          "enum": ["ABOVE", "BELOW"]
        },
        "targetPrice": {
          "type": "number",
          "description": "Threshold price per unit."
        },
        "currency": {
          "type": "string",
          "description": "Threshold currency.",
          "enum": ["INR", "USD"]
        },
        "unit": {
          "type": "string",
          "description": "Weight unit for targetPrice.",
          "enum": ["10g", "1g", "oz", "kg"]
        },
        "status": {
          "type": "string",
          "description": "Alert lifecycle state; triggered is terminal.",
          "enum": ["active", "paused", "triggered"]
        },
        "note": {
          "type": "string",
          "description": "Optional trading reminder note.",
          "minLength": 0,
          "maxLength": 80
        },
        "triggeredPrice": {
          "type": "number",
          "description": "Observed market price at trigger time (0 until triggered)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "userId",
        "metal",
        "condition",
        "targetPrice",
        "currency",
        "unit",
        "status",
        "note",
        "triggeredPrice",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user settings and profile document."
    },
    "/users/{userId}/holdings/{holdingId}": {
      "schema": { "$ref": "#/entities/PortfolioHolding" },
      "description": "User's Gold and Silver portfolio lots for real-time P&L calculation."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "User's configured price threshold alerts."
    }
  }
}
