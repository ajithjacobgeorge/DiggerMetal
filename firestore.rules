rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'userId',
          'displayName',
          'preferredCurrency',
          'preferredUnit',
          'indiaCity',
          'includeIndiaTaxes',
          'notificationsEnabled',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'displayName',
          'preferredCurrency',
          'preferredUnit',
          'indiaCity',
          'includeIndiaTaxes',
          'notificationsEnabled',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.preferredCurrency in ['INR', 'USD'] &&
        data.preferredUnit in ['10g', '1g', 'oz', 'kg'] &&
        data.indiaCity in ['Mumbai', 'Delhi', 'Chennai', 'Bengaluru', 'Kolkata', 'Hyderabad'] &&
        data.includeIndiaTaxes is bool &&
        data.notificationsEnabled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPortfolioHolding(data, userId) {
      return data.keys().hasAll([
          'userId',
          'metal',
          'purity',
          'quantity',
          'unit',
          'buyPrice',
          'currency',
          'purchaseDate',
          'label',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'metal',
          'purity',
          'quantity',
          'unit',
          'buyPrice',
          'currency',
          'purchaseDate',
          'label',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.metal in ['GOLD', 'SILVER'] &&
        data.purity in ['24K', '22K', '18K', '999'] &&
        data.quantity is number &&
        data.quantity > 0 &&
        data.quantity <= 1000000 &&
        data.unit in ['g', '10g', 'oz', 'kg'] &&
        data.buyPrice is number &&
        data.buyPrice > 0 &&
        data.buyPrice <= 1000000000 &&
        data.currency in ['INR', 'USD'] &&
        data.purchaseDate is string &&
        data.purchaseDate.size() == 10 &&
        data.purchaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.label is string &&
        data.label.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPriceAlert(data, userId) {
      return data.keys().hasAll([
          'userId',
          'metal',
          'condition',
          'targetPrice',
          'currency',
          'unit',
          'status',
          'note',
          'triggeredPrice',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'metal',
          'condition',
          'targetPrice',
          'currency',
          'unit',
          'status',
          'note',
          'triggeredPrice',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.metal in ['GOLD', 'SILVER'] &&
        data.condition in ['ABOVE', 'BELOW'] &&
        data.targetPrice is number &&
        data.targetPrice > 0 &&
        data.targetPrice <= 1000000000 &&
        data.currency in ['INR', 'USD'] &&
        data.unit in ['10g', '1g', 'oz', 'kg'] &&
        data.status in ['active', 'paused', 'triggered'] &&
        data.note is string &&
        data.note.size() <= 80 &&
        data.triggeredPrice is number &&
        data.triggeredPrice >= 0 &&
        data.triggeredPrice <= 1000000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. User Profile & Preferences (Owner-Isolated)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: Update Preferences
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'preferredCurrency',
            'preferredUnit',
            'indiaCity',
            'includeIndiaTaxes',
            'notificationsEnabled',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      // 2. Portfolio Holdings Subcollection
      match /holdings/{holdingId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);

        allow list: if isOwner(userId) &&
          resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          isValidPortfolioHolding(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          isValidPortfolioHolding(incoming(), userId) &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) && (
            // Action: Edit Holding Details
            incoming().diff(existing()).affectedKeys().hasOnly([
              'metal',
              'purity',
              'quantity',
              'unit',
              'buyPrice',
              'currency',
              'purchaseDate',
              'label',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }

      // 3. Price Alerts Subcollection
      match /alerts/{alertId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);

        allow list: if isOwner(userId) &&
          resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          isValidPriceAlert(incoming(), userId) &&
          incoming().status == 'active' &&
          incoming().triggeredPrice == 0 &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          isValidPriceAlert(incoming(), userId) &&
          existing().userId == request.auth.uid &&
          existing().status != 'triggered' &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) && (
            // Action 1: Toggle Pause / Resume
            (
              incoming().status in ['active', 'paused'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            // Action 2: Edit Alert Threshold
            (
              incoming().status in ['active', 'paused'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'condition',
                'targetPrice',
                'note',
                'updatedAt'
              ])
            ) ||
            // Action 3: Mark Alert as Triggered (Terminal State)
            (
              existing().status == 'active' &&
              incoming().status == 'triggered' &&
              incoming().triggeredPrice > 0 &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status',
                'triggeredPrice',
                'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }
    }
  }
}
